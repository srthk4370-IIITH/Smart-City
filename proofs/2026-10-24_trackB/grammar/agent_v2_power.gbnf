# v2 power agent answer, continuation after the prefill {"pattern": "
root ::= pat "\", \"status\": \"" ( fault | event )
fault ::= "sensor_fault\", " obsarr ", \"likely_cause\": \"sensor_fault" "\", \"confidence\": " conf ", \"event_active\": " bool ", \"onset\": \"" hhmm "\"" ", \"fault_kind\": \"" fk "\"" act-tail
event ::= ns "\", " obsarr ", \"likely_cause\": \"" cause "\", \"confidence\": " conf ", \"event_active\": " bool ", \"onset\": \"" hhmm "\"" act-tail
act-tail ::= ", \"action\": \"" act "\"}"
pat ::= "dip" | "erratic" | "exponential_increase" | "flatline" | "gradual_decrease" | "gradual_increase" | "oscillation" | "spike" | "stable" | "step_decrease" | "step_increase" | "throttling"
ns ::= "normal" | "warning" | "critical"
cause ::= "capacity_limit_throttling" | "cyclic_equipment" | "equipment_startup" | "gradual_load_growth" | "load_drop_or_outage" | "load_surge" | "normal_load" | "power_quality_issue"
fk ::= "bias" | "drift" | "dropout" | "noise" | "quantised" | "saturation" | "stuck"
act ::= "check_sensor" | "inspect_electrical" | "inspect_hvac" | "inspect_ventilation" | "inspect_water_system" | "monitor" | "none" | "request_facility_review" | "review_schedule"
obsarr ::= "\"observations\": [" obs ( ", " obs )? "]"
obs ::= "\"" [^"\\\[\]]+ "[" eid ( "," eid )* "]\""
eid ::= "E" ( "10" | [1-9] )
conf ::= "0." [0-9] [0-9]? | "1.0"
bool ::= "true" | "false"
hhmm ::= ( [01] [0-9] | "2" [0-3] ) ":" [0-5] [0-9]
