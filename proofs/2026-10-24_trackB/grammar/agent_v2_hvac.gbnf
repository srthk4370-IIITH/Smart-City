# v2 hvac agent answer, continuation after the prefill {"pattern": "
root ::= pat "\", \"status\": \"" ( fault | event )
fault ::= "sensor_fault\", " obsarr ", \"likely_cause\": \"sensor_fault" "\", \"confidence\": " conf ", \"event_active\": " bool ", \"onset\": \"" hhmm "\"" ", \"fault_kind\": \"" fk "\"" act-tail
event ::= ns "\", " obsarr ", \"likely_cause\": \"" cause "\", \"confidence\": " conf ", \"event_active\": " bool ", \"onset\": \"" hhmm "\"" act-tail
act-tail ::= ", \"action\": \"" act "\"}"
pat ::= "bias_jump" | "biased_reading" | "calibration_drift" | "dropout" | "erratic" | "flatline" | "no_cooling_effect" | "normal_cycling" | "pull_down" | "quantised" | "running_empty_room" | "saturation" | "setback_drift" | "short_cycling" | "slow_recovery" | "stable" | "stuck_off" | "stuck_on" | "too_cold" | "too_hot" | "unit_alarm"
ns ::= "normal" | "warning" | "critical"
cause ::= "ac_not_cooling" | "ac_off_heat_gain" | "high_heat_load" | "normal_operation" | "overcooling" | "schedule_or_control_fault" | "scheduled_off" | "short_cycling_control" | "unit_alarm" | "unit_not_starting" | "unoccupied_running"
fk ::= "bias" | "drift" | "dropout" | "noise" | "quantised" | "saturation" | "stuck"
act ::= "check_sensor" | "inspect_electrical" | "inspect_hvac" | "inspect_ventilation" | "inspect_water_system" | "monitor" | "none" | "request_facility_review" | "review_schedule" | "switch_off_ac"
obsarr ::= "\"observations\": [" obs ( ", " obs )? "]"
obs ::= "\"" [^"\\\[\]]+ "[" eid ( "," eid )* "]\""
eid ::= "E" ( "10" | [1-9] )
conf ::= "0." [0-9] [0-9]? | "1.0"
bool ::= "true" | "false"
hhmm ::= ( [01] [0-9] | "2" [0-3] ) ":" [0-5] [0-9]
