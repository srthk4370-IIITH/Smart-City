+// HTPD_GRAMMAR: the stream's GBNF (llama_sampler_init_grammar) as a mask on greedy, applied lazily like
+// llama-server's grammar_first sampling: the greedy (or trie) choice is tested alone first, so a stream that stays
+// on-grammar costs one stack walk per token; only a rejected token masks the whole vocabulary (one pass over
+// 128k pieces) and takes the highest-logit allowed token (first index on ties, like argmax). The kept token is
+// accepted into the grammar state here: every pick() result is consumed by the caller (draft verification stops
+// at the first mismatch, after consuming that pick), so the state stays in step with the stream's text.
+static llama_token grammar_pick(const float * logits, int n_vocab, llama_sampler * g, llama_token t, int * forced) {
+    llama_token_data one = {t, logits[t], 0.0f};
+    llama_token_data_array a1 = {&one, 1, -1, false};
+    llama_sampler_apply(g, &a1);
+    if (!std::isfinite(a1.data[0].logit)) {
+        static std::vector<llama_token_data> cand;  // decode loop is single-threaded
+        cand.resize(n_vocab);
+        for (int i = 0; i < n_vocab; ++i) cand[i] = {i, logits[i], 0.0f};
+        llama_token_data_array a = {cand.data(), (size_t) n_vocab, -1, false};
+        llama_sampler_apply(g, &a);
+        llama_token best = -1;
+        float bv = -INFINITY;
+        for (size_t i = 0; i < a.size; ++i)
+            if (std::isfinite(a.data[i].logit) && (best < 0 || a.data[i].logit > bv)) { best = a.data[i].id; bv = a.data[i].logit; }
+        if (best < 0) return t;  // grammar has no continuation (cannot happen before the stop rule fires): stay greedy, no accept
+        if (best != t && forced) (*forced)++;
+        t = best;
+    }
+    llama_sampler_accept(g, t);
+    return t;
+}
+
+static llama_token pick(const float * logits, int n_vocab, const Scanner & sc, const StreamOpt * o, int * forced) {
+    llama_token t = pick_label(logits, n_vocab, sc, o, forced);
+    if (o && o->grammar) t = grammar_pick(logits, n_vocab, o->grammar.get(), t, forced);
+    return t;
+}
