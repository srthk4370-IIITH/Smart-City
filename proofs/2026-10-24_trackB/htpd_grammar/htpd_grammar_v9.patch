+// HTPD_GRAMMAR=2: the role's grammar file, chosen by the system prompt's "You are the <Role> agent" line. Parsed once
+// per file into a prototype sampler; each stream gets a clone (fresh state).
+static std::shared_ptr<llama_sampler> grammar_for(const std::string & prompt, const std::string * req_gbnf) {
+    static std::map<std::string, std::shared_ptr<llama_sampler>> protos;  // GBNF text -> parsed prototype
+    std::string gbnf;
+    if (req_gbnf) gbnf = *req_gbnf;
+    else if (g_grammar >= 2 && !g_grammar_dir.empty()) {
+        static const std::pair<const char *, const char *> roles[] = {
+            {"You are the Air Quality agent", "air_quality"}, {"You are the Water agent", "water"},
+            {"You are the Power agent", "power"}, {"You are the Occupancy agent", "occupancy"},
+            {"You are the Weather agent", "weather"}, {"You are the HVAC agent", "hvac"}};
+        static std::map<std::string, std::string> files;
+        for (auto & r : roles) {
+            if (prompt.find(r.first) == std::string::npos) continue;
+            auto it = files.find(r.second);
+            if (it == files.end()) {
+                std::string path = g_grammar_dir + "/agent_v2_" + r.second + ".gbnf", s;
+                if (FILE * f = fopen(path.c_str(), "rb")) {
+                    char buf[4096];
+                    size_t k;
+                    while ((k = fread(buf, 1, sizeof buf, f)) > 0) s.append(buf, k);
+                    fclose(f);
+                } else fprintf(stderr, "htpd: grammar file %s missing - role unconstrained\n", path.c_str());
+                it = files.emplace(r.second, s).first;
+            }
+            gbnf = it->second;
+            break;
+        }
+    }
+    if (gbnf.empty()) return nullptr;
+    auto it = protos.find(gbnf);
+    if (it == protos.end()) {
+        llama_sampler * p = llama_sampler_init_grammar(g_vocab, gbnf.c_str(), "root");
+        if (!p) fprintf(stderr, "htpd: grammar failed to parse - stream unconstrained\n");
+        it = protos.emplace(gbnf, std::shared_ptr<llama_sampler>(p, [](llama_sampler * s) { if (s) llama_sampler_free(s); })).first;
+    }
+    if (!it->second) return nullptr;
+    return std::shared_ptr<llama_sampler>(llama_sampler_clone(it->second.get()), llama_sampler_free);
+}
