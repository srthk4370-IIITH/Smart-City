+        if (victim == g_rcache.end())
+            for (auto it = g_rcache.begin(); it != g_rcache.end(); ++it) if (!it->turn) { victim = it; break; }
+        if (victim != g_rcache.end()) g_rcache.erase(victim);
+    }
+    g_rcache.push_back({std::move(key), std::move(blob), false});
+}
