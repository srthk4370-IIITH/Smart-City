<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds (SCE_RELEASE=1 bash build_apk.sh): cleartext HTTP only to the board's own backend on loopback.
     Everything else (fog, ntfy, campus API) is made by the Go backend process, not by the app's WebView/Java code. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
