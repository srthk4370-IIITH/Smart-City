+void InferenceScheduler::evictSlotLocked(uint32_t s, const std::string& why) {
+  failPendingLocked(s, why);
+  if (m_max_slots > 1 && m_slot_kv[s].n_recent == 0) {
+    addSharedFree(m_kv_indices[s]);
+    addSharedFree(m_slot_kv[s].free_idxes);
+    m_kv_indices[s].clear();
+    m_slot_kv[s].free_idxes.clear();
+    m_n_past[s] = 0;
+    m_slot_checkpoints[s].clear();
+  }
+}
