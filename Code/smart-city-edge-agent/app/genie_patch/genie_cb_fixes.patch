+// [genie_patch F4] caller holds m_mutex
+void InferenceScheduler::addSharedFree(const std::vector<uint32_t>& positions) {
+  if (positions.empty()) return;
+  m_shared_free.insert(m_shared_free.end(), positions.begin(), positions.end());
+  std::sort(m_shared_free.begin(), m_shared_free.end());
+  m_shared_free.erase(std::unique(m_shared_free.begin(), m_shared_free.end()),
+                      m_shared_free.end());
+}
+
+// [genie_patch F4] caller holds m_mutex
+void InferenceScheduler::failPendingLocked(uint32_t s, const std::string& why) {
+  PendingReq& p = m_pending[s];
+  if (!p.has_pending) return;
+  try {
+    p.promise.set_exception(std::make_exception_ptr(genie::ContextLimitException(why)));
+  } catch (...) {
+  }
+  if (p.phase == SlotPhase::DECODE) --m_n_decode_pending;
+  if (p.phase == SlotPhase::PREFILL) --m_n_prefill_pending;
+  --m_n_pending;
+  p.has_pending = false;
+  p.tokens.clear();
+  p.embeddings.clear();
+  p.embedding_bytes_per_token = 0;
+  p.embeddings_perlayer.clear();
+  p.attention_map.clear();
+  p.consumed       = 0;
+  p.feature_vector = nullptr;
+  p.selected.clear();
+  p.eaglet_start_idx = 0;
+  p.post_update      = false;
+  // The dialog is about to unwind; stop counting it as an active decoder so the
+  // other slots' decode fires are not held back waiting for it (markSlotIdle
+  // from the dialog's scope guard is then a no-op).
+  if (m_slot_phase[s] == LifecyclePhase::DECODE) {
+    --m_n_decode_active;
+    m_slot_phase[s] = LifecyclePhase::UNDEFINED;
+  }
+}
