# Virtual environments
.venv/
.bootstrap-venv/
venv/

# Python
__pycache__/
*.py[cod]
*.pyo

# ADB / Android platform tools binaries (large — user installs separately)
# platform-tools/ is included since it's just ADB (~12MB), needed for Windows users

# Data — raw sensor dataset (3.5 GB, not in repo)
data/

# Node / npm (if any frontend tooling added)
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Logs
*.log

# ---- Large / proprietary artifacts (never pushed; see run.md for how to get or rebuild them) ----
# Model weights and NPU context binaries (GBs)
*.bin
*.bin.truncated
*.safetensors
*.gguf
*.onnx.data
*.encodings
# Qualcomm QAIRT / Genie runtime (licensed SDK files) and the laptop restore copy of the device
qidk_backup/runtime/
qidk_backup/genie_bundle_ft/
qidk_backup/app/
# Datasets (GBs) and Python wheels
ihub-clean-datasets/
*.zip
.wheels/
*.whl
# Fine-tuning outputs: adapter weights + their tokenizer copy (eval reports are kept)
Code/smart-city-edge-agent/training/results/*/adapter/
Code/smart-city-edge-agent/training/export/_tmp/
# Build outputs (rebuilt by app/build.sh and app/android/build_apk.sh)
Code/smart-city-edge-agent/app/device/edge-agent
Code/smart-city-edge-agent/app/device/edge-agent-host
Code/smart-city-edge-agent/app/android/out/
Code/smart-city-edge-agent/app/android/build/
*.apk
*.idsig
# Runtime state of the app (incident history, prompts)
Code/smart-city-edge-agent/app/device/state/
# Local screenshots / scratch
error.jpeg
# ...but the app's sensor definitions are small and required
!Code/smart-city-edge-agent/app/device/data/

# on-device Go test binary (regenerate with: go test -c -o device/batch.test .)
Code/smart-city-edge-agent/app/device/batch.test

# genied: SDK headers and libGenie.so staged by app/genied/build.sh (they belong to QAIRT, not here)
Code/smart-city-edge-agent/app/genied/include/
Code/smart-city-edge-agent/app/genied/lib/
Code/smart-city-edge-agent/app/device/genied
_stage_lade/

# 14 GB fine-tuned checkpoint backup: insurance copy, never source control
qidk_backup/ckpt_ftgptq16/
# bundle staging dirs used to move 2.5 GB exports to the device
_stage_ctx2048/

# device screenshots taken while iterating on the UI
_shots/
# generated reference answers for verify_daemon.py (machine-specific)
Code/smart-city-edge-agent/training/export/_daemon_ref.json

# exported feedback datasets (regenerate with training/feedback/export_feedback.py)
Code/smart-city-edge-agent/training/feedback/data/

Code/smart-city-edge-agent/training/export/_large_prompt.txt
Code/smart-city-edge-agent/training/export/_daemon_ref_large.json
Code/smart-city-edge-agent/app/tools/stress_report.json
